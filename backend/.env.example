# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o GitHub.
PORT=3000

# --- Banco local (SQL Server no seu PC) ---
DB_SERVER=localhost
DB_DATABASE=ERP_PDV_Master
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Banco na nuvem (Azure SQL) — use estes valores no painel do Render ---
# DB_SERVER=seu-servidor.database.windows.net
# DB_ENCRYPT=true
# DB_TRUST_CERT=false

LOJA_NOME="Logi Flow"
PIX_CHAVE=sua_chave_pix
PIX_NOME="Logi Flow"
PIX_CIDADE=São Paulo

# Senha provisória do usuário "admin" criado no primeiro start (obrigado a trocar no 1º login)
ADMIN_SENHA_INICIAL=troque_esta_senha
